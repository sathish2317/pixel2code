# Copy this file to .env and fill it in. NEVER commit or share .env.
# Pick ONE provider.

AI_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=put-your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Or Groq (cannot read PDFs):
# AI_PROVIDER=groq
# GROQ_API_KEY=put-your-key-here
# GROQ_MODEL=qwen/qwen3.8-27b

# Any long secret string. The app sends it as the x-app-token header.
APP_TOKEN=change-me-to-a-long-random-string
PORT=8787

# --- Optional (defaults are fine) ---
# Several users, each with their own token (projects are private per user). APP_TOKEN alone = one user.
# APP_USERS=alice:long-secret-1,bob:long-secret-2
# SQLite file location (default server/data/pixel2code.db). Needs Node.js 22.13+.
# DB_PATH=./data/pixel2code.db
# AI_TIMEOUT_MS=240000
# AI_MAX_ATTEMPTS=3
# Comma separated browser origins allowed to call the API (default: any)
# CORS_ORIGIN=https://your-site.example
